# Frontend Configuration Example
# Renommez ce fichier en .env et ajustez les valeurs selon votre environnement

# ================= API Configuration =================
# L'URL du backend API
# Développement local: http://localhost:8080
# Production: https://api.example.com
VITE_API_URL=http://localhost:8080

# Timeout des requêtes API (en millisecondes)
# Par défaut: 30000 (30 secondes)
VITE_API_TIMEOUT=30000

# ================= Application =================
# Nom de l'application affiché dans la barre de navigation
VITE_APP_NAME=Gestion des Congés

# Version de l'application
VITE_APP_VERSION=1.0.0

# ================= Environment =================
# development | production
# Défini automatiquement, mais peut être surchargé ici
NODE_ENV=development

# ================= Logging =================
# Activer les logs détaillés en développement
VITE_DEBUG=true

# ================= Features =================
# Activer/désactiver certaines fonctionnalités
VITE_FEATURE_RTT=true
VITE_FEATURE_EXCEPTIONAL_LEAVES=true
VITE_FEATURE_EXPORT_PDF=true
VITE_FEATURE_EXPORT_EXCEL=true

# ================= Countries =================
# Pays supportés (séparés par des virgules)
# Valeurs supportées: TN (Tunisie), FR (France), MA (Maroc)
VITE_SUPPORTED_COUNTRIES=TN,FR,MA

# ================= Dashboard =================
# Nombre de demandes affichées par page
VITE_REQUESTS_PER_PAGE=10

# ================= Calendrier =================
# Premier jour de la semaine (0 = dimanche, 1 = lundi, etc.)
VITE_WEEK_START_DAY=1

# ================= Thème =================
# Thème par défaut: light | dark | auto
VITE_THEME=auto

# ================= URLs Externes =================
# Documentation
VITE_DOCS_URL=http://localhost:5173/docs

# Support/Contact
VITE_SUPPORT_EMAIL=hamdihamdisfaxi@gmail.com
